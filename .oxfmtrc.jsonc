{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "sortPackageJson": false,
  "sortImports": {
    "groups": [
      "type-import",
      ["type-parent", "type-sibling", "type-index", "type-internal"],
      "value-builtin",
      "value-external",
      "value-internal",
      ["value-parent", "value-sibling", "value-index"],
      "side_effect",
      "unknown",
    ],
    "newlinesBetween": false,
  },
  "overrides": [
    {
      // code blocks in the docs are written by hand to look good
      "files": ["**/*.md"],
      "options": { "embeddedLanguageFormatting": "off" },
    },
  ],
  "ignorePatterns": [
    "**/fixtures",
    "**/*.timestamp-*",
    "pnpm-lock.yaml",
    // generated by the build
    "packages/*/LICENSE.md",
    "docs/guide/cli-generated.md",
    "docs/.vitepress/contributor-names.json",
    "packages/browser/src/client/public/esm-client-injector.js",
    "test/unit/src/wasm/wasm-bindgen*",
    // test inputs that depend on the exact source text
    "test/unit/src/self",
    "test/unit/test/mocking/already-hoisted.test.ts",
    "test/unit/test/tab-effect.spec.mjs",
    "test/unit/test/mocking/external.test.ts",
    "test/workspaces/results.json",
    "test/workspaces-browser/results.json",
    "test/e2e/deps/error",
    "test/e2e/deps/malformed-source-map",
  ],
}
