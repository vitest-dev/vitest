{
  "name": "docs",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vitepress --port 3333 --open",
    "build": "nr cli-table && nr prefetch && vitepress build",
    "cli-table": "node .vitepress/scripts/cli-generator.ts",
    "build-no-prefetch": "vitepress build",
    "serve": "vitepress serve",
    "deploy": "wrangler deploy",
    "preview-https": "pnpm run build && serve .vitepress/dist",
    "preview-https-no-prefetch": "pnpm run build-no-prefetch && serve .vitepress/dist",
    "prefetch": "node .vitepress/scripts/fetch-avatars.ts",
    "generate-pwa-icons": "pwa-assets-generator"
  },
  "dependencies": {
    "@vueuse/core": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@antfu/ni": "^30.6.0",
    "@iconify-json/carbon": "catalog:",
    "@iconify-json/logos": "catalog:",
    "@iconify/vue": "catalog:",
    "@shikijs/transformers": "^4.4.3",
    "@shikijs/vitepress-twoslash": "^4.4.3",
    "@unocss/reset": "catalog:",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vite-pwa/vitepress": "^1.1.0",
    "@vitejs/plugin-vue": "catalog:",
    "@voidzero-dev/vitepress-theme": "^5.0.7",
    "https-localhost": "^4.7.2",
    "pathe": "catalog:",
    "tinyglobby": "catalog:",
    "unocss": "catalog:",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitepress": "2.0.0-alpha.20",
    "vitepress-plugin-group-icons": "^1.7.6",
    "vitepress-plugin-llms": "^1.14.0",
    "vitepress-plugin-tabs": "^0.9.1",
    "vitest": "workspace:*",
    "workbox-window": "^7.4.1",
    "wrangler": "catalog:"
  }
}
